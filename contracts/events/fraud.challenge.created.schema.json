{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antifraude.internal/contracts/events/fraud.challenge.created/1.0.schema.json",
  "title": "fraud.challenge.created",
  "description": "Evento interno publicado quando a decisao online classifica uma transacao como challenge. Consumido pela fila de triagem. CPF nunca em claro: titular identificado por cpf_token.",
  "type": "object",
  "required": [
    "event",
    "schema_version",
    "idempotency_key",
    "transaction_id",
    "correlation_id",
    "cpf_token",
    "occurred_at",
    "decision_initial",
    "scores",
    "thresholds",
    "signals",
    "model_versions",
    "layers_executed",
    "short_circuit_layer",
    "ttl_seconds"
  ],
  "additionalProperties": false,
  "properties": {
    "event": {
      "const": "fraud.challenge.created"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Versao do contrato do evento (ex.: 1.0)."
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador da entrega. Reemissao reutiliza idempotency_key, nao o event_id."
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "description": "Convencao: transaction_id + ':' + schema_version."
    },
    "transaction_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "cpf_token": {
      "type": "string",
      "minLength": 1,
      "description": "CPF tokenizado ou identificador interno. Nunca o CPF em claro."
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_initial": {
      "type": "string",
      "enum": ["challenge"]
    },
    "scores": {
      "type": "object",
      "required": ["final"],
      "additionalProperties": false,
      "properties": {
        "hbos": {
          "type": ["number", "null"],
          "description": "Score de anomalia do HBOS. Null se a camada nao executou ou hbos_unavailable. Nao e prova de fraude."
        },
        "xgb": {
          "type": ["number", "null"],
          "description": "Score do XGBoost global. Null se skipped ou xgb_unavailable."
        },
        "final": {
          "type": "number",
          "description": "Score consolidado da media ponderada."
        }
      }
    },
    "thresholds": {
      "type": "object",
      "required": ["approve_max", "deny_min"],
      "additionalProperties": false,
      "properties": {
        "approve_max": {
          "type": "number"
        },
        "deny_min": {
          "type": "number"
        }
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Reason codes / sinais acionados, ex.: valor_acima_padrao, estabelecimento_novo, cold_start."
    },
    "features": {
      "type": "object",
      "description": "Features minimizadas para os validadores. Cardinalidade nao e canonica enquanto o registry estiver unreconciled.",
      "additionalProperties": true
    },
    "feature_weights": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "model_versions": {
      "type": "object",
      "required": ["hbos", "xgb"],
      "additionalProperties": false,
      "properties": {
        "hbos": {
          "type": ["string", "null"]
        },
        "xgb": {
          "type": ["string", "null"]
        }
      }
    },
    "layers_executed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "layers_skipped": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "short_circuit_layer": {
      "type": ["string", "null"],
      "description": "Camada que encerrou a cascata, ou null se nao houve short-circuit."
    },
    "fallback_reason": {
      "type": ["string", "null"],
      "enum": ["hbos_unavailable", "xgb_unavailable", null]
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "description": "Referencia do briefing: 900."
    },
    "shadow_mode": {
      "type": "boolean",
      "description": "True quando a avaliacao e amostra shadow e nao deve entrar na fila operacional."
    },
        "feature_schema_version": {
          "type": ["string", "null"],
          "description": "features:candidate-2026.08.25 enquanto D-2 nao estiver reconciled. Nao usar 10 ou 13 como versao."
        }
  }
}
