{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senff.local/schemas/fraud.challenge.resolved.json",
  "title": "fraud.challenge.resolved",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_name",
    "event_version",
    "transaction_id",
    "correlation_id",
    "subject_id",
    "timestamp",
    "final_decision",
    "reason_codes",
    "validators"
  ],
  "properties": {
    "event_name": { "const": "fraud.challenge.resolved" },
    "event_version": { "type": "string" },
    "transaction_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "subject_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "final_decision": { "type": "string", "enum": ["approve", "deny", "escalate"] },
    "reason_codes": { "type": "array", "items": { "type": "string" } },
    "notification_sent": { "type": "boolean" },
    "validators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "validator_id",
          "version",
          "decision",
          "duration_ms",
          "reason_codes"
        ],
        "properties": {
          "validator_id": { "type": "string" },
          "version": { "type": "string" },
          "decision": { "type": "string", "enum": ["approve", "deny", "escalate"] },
          "duration_ms": { "type": "number", "minimum": 0 },
          "reason_codes": { "type": "array", "items": { "type": "string" } },
          "error": { "type": ["string", "null"] },
          "timeout": { "type": "boolean" },
          "fallback": { "type": ["string", "null"] }
        }
      }
    }
  }
}
