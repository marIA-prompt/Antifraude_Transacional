{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antifraude.internal/schemas/validator-result/1.0.0",
  "title": "Resultado de validador da trilha de challenge",
  "description": "Contrato de saida de qualquer validador do workflow. Registra duracao, resultado, erro, timeout e fallback, conforme CA-1.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "validator_id",
    "validator_version",
    "transaction_id",
    "correlation_id",
    "started_at",
    "completed_at",
    "duration_ms",
    "status",
    "outcome",
    "confidence",
    "reason_codes",
    "fallback_applied"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "validator_id": {
      "enum": [
        "additional_rules",
        "blocklist_bureau",
        "geo_device",
        "extended_history",
        "stepup",
        "ai_triage_assist"
      ]
    },
    "validator_version": { "type": "string", "minLength": 1 },
    "transaction_id": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "number", "minimum": 0 },
    "status": {
      "description": "completed: executou; timeout, error e circuit_open exigem outcome derivado do fallback seguro.",
      "enum": ["completed", "timeout", "error", "circuit_open", "skipped"]
    },
    "outcome": { "enum": ["approve", "deny", "escalate"] },
    "confidence": { "enum": ["low", "medium", "high"] },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^RC_[A-Z0-9_]{2,48}$" }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "description"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "collected_at": { "type": "string", "format": "date-time" },
          "reference": { "type": "string" }
        }
      }
    },
    "fallback_applied": { "type": "boolean" },
    "fallback_reason_code": {
      "oneOf": [{ "type": "string", "pattern": "^RC_[A-Z0-9_]{2,48}$" }, { "type": "null" }]
    },
    "error": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string" },
            "retryable": { "type": "boolean" }
          }
        },
        { "type": "null" }
      ]
    },
    "terminates_workflow": {
      "description": "true quando o resultado e deny de alta confianca e encerra a cadeia sem chamar os validadores seguintes.",
      "type": "boolean"
    },
    "checkpoint_id": {
      "description": "Referencia de retomada para integracoes lentas e step-up.",
      "type": ["string", "null"]
    }
  },
  "allOf": [
    {
      "description": "Falha de execucao exige fallback declarado.",
      "if": {
        "properties": { "status": { "enum": ["timeout", "error", "circuit_open"] } },
        "required": ["status"]
      },
      "then": {
        "properties": { "fallback_applied": { "const": true } },
        "required": ["fallback_reason_code"]
      }
    },
    {
      "description": "Encerramento antecipado exige deny de alta confianca.",
      "if": {
        "properties": { "terminates_workflow": { "const": true } },
        "required": ["terminates_workflow"]
      },
      "then": {
        "properties": {
          "outcome": { "const": "deny" },
          "confidence": { "const": "high" }
        }
      }
    }
  ]
}
